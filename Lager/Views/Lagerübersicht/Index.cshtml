@model IEnumerable<Lager.Models.LagerübersichtViewModel>

@{
    ViewData["Title"] = "Lagerübersicht";

    var top3Bestand = Model
    .OrderByDescending(a => a.Bestand)
    .Take(3)
    .ToList();

    var top3Wert = Model
        .Where(a => a.Gesamtwert > 0)
        .OrderByDescending(a => a.Gesamtwert)
        .Take(3)
        .ToList();
}

<h1>Lagerübersicht</h1>

<hr />

<h2>Aktueller Lagerbestand</h2>

<table class="table">
    <thead>
        <tr>
            <th>Artikelnummer</th>
            <th>Artikelname</th>
            <th>Bestand</th>
            <th>Durchschnittspreis</th>
            <th>Gesamtwert</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Artikelnummer</td>
                <td>@item.Artikelname</td>
                <td>@item.Bestand</td>
                <td>@item.Durchschnittspreis.ToString("C")</td>
                <td>@item.Gesamtwert.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h2>Statistik</h2>

<h3>Top 3 Artikel nach Bestand</h3>

<table class="table">
    <thead>
        <tr>
            <th>Platz</th>
            <th>Artikelnummer</th>
            <th>Artikelname</th>
            <th>Bestand</th>
        </tr>
    </thead>

    <tbody>
        @{
            int platz = 1;
        }

        @foreach (var item in top3Bestand)
        {
            <tr>
                <td>@platz</td>
                <td>@item.Artikelnummer</td>
                <td>@item.Artikelname</td>
                <td>@item.Bestand</td>
            </tr>

            platz++;
        }
    </tbody>
</table>

<h3>Top 3 Artikel nach Gesamtwert</h3>

<table class="table">
    <thead>
        <tr>
            <th>Platz</th>
            <th>Artikelnummer</th>
            <th>Artikelname</th>
            <th>Gesamtwert</th>
        </tr>
    </thead>

    <tbody>
        @{
            int wertPlatz = 1;
        }

        @foreach (var item in top3Wert)
        {
            <tr>
                <td>@wertPlatz</td>
                <td>@item.Artikelnummer</td>
                <td>@item.Artikelname</td>
                <td>@item.Gesamtwert.ToString("C")</td>
            </tr>

            wertPlatz++;
        }
    </tbody>
</table>
