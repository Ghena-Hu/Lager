@model Lager.Models.Buchung

@{
    ViewData["Title"] = "Buchung bearbeiten";
}

<h1>Buchung bearbeiten</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden"
                   asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="ArtikelId" class="control-label">
                    Artikel
                </label>

                <select asp-for="ArtikelId"
                        class="form-control"
                        asp-items="ViewBag.ArtikelListe">
                    <option value="">-- Artikel auswählen --</option>
                </select>

                <span asp-validation-for="ArtikelId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Datum" class="control-label">
                    Datum
                </label>

                <input asp-for="Datum"
                       class="form-control"
                       type="datetime-local" />

                <span asp-validation-for="Datum"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Menge" class="control-label">
                    Menge
                </label>

                <input asp-for="Menge"
                       class="form-control"
                       type="number" />

                <span asp-validation-for="Menge"
                      class="text-danger"></span>

                <small class="form-text text-muted">
                    Positive Zahl = Wareneingang,
                    negative Zahl = Warenausgang.
                </small>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Preis" class="control-label">
                    Einkaufspreis pro Stück
                </label>

                <input asp-for="Preis"
                       class="form-control"
                       type="number"
                       step="0.01" />

                <span asp-validation-for="Preis"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Speichern"
                       class="btn btn-primary" />

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Zurück
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}