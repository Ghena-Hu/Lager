@model IEnumerable<Lager.Models.Artikel>

@{
    ViewData["Title"] = "Artikel";
}

<h1>Artikel</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Neuen Artikel anlegen
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Artikelnummer</th>
            <th>Artikelname</th>
            <th>Beschreibung</th>
            <th>Aktionen</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Artikelnummer</td>
                <td>@item.Artikelname</td>
                <td>@item.Beschreibung</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id">
                        Bearbeiten
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@item.Id">
                        Löschen
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>