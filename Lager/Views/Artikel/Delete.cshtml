@model Lager.Models.Artikel

@{
    ViewData["Title"] = "Artikel löschen";
}

<h1>Artikel löschen</h1>

<h3>Möchten Sie diesen Artikel wirklich löschen?</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Artikelnummer
    </dt>

    <dd class="col-sm-9">
        @Model.Artikelnummer
    </dd>

    <dt class="col-sm-3">
        Artikelname
    </dt>

    <dd class="col-sm-9">
        @Model.Artikelname
    </dd>

    <dt class="col-sm-3">
        Beschreibung
    </dt>

    <dd class="col-sm-9">
        @Model.Beschreibung
    </dd>

</dl>

<form asp-action="Delete">

    <input type="hidden"
           asp-for="Id" />

    <input type="submit"
           value="Löschen"
           class="btn btn-danger" />

    <a asp-action="Index"
       class="btn btn-secondary">
        Abbrechen
    </a>

</form>
